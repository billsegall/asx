# ASX project crontab — canonical source of truth
# Install on harri: crontab /home/bill/code/asx/crontab
#
# m h  dom mon dow   command
SHELL=/bin/bash
STOCKDB=/home/bill/code/asx/asx-data/stockdb
DATA=/home/bill/code/asx/asx-data
ANNOUNCEMENTS=/home/bill/code/asx/asx-announcements
WEB=/home/bill/code/asx/asx-web
METALS_DEV_API_KEY=ISPELSLJBHBURV1FQYO43651FQYO4

# First day of each month at 08:00 — symbols
0 8 1 * * { [ "$(date +\%d)" = "01" ] || [ "$(date +\%u)" = "1" ]; } && make -C $STOCKDB fetch_symbols >> /tmp/fetch_symbols.log

# And then get the list of name changes
15 8 1 * * python3 $DATA/scripts/fetch_symbol_changes.py --db $STOCKDB/stockdb.db >> /tmp/symbol-changes.log

# Every trading day at 08:00 — short positions
0 8 * * 1-5 make -C $STOCKDB fetch_shorts >> /tmp/fetch_shorts.log

# Every week at 08:15 — splits
0 8 * * 1-5 /bin/python3 $STOCKDB/fetch_splits.py --db $STOCKDB/stockdb.db >> /tmp/fetch_splits.log

# Weekly options refresh (Sunday 6am AEST = Saturday 20:00 UTC)
0 20 * * 6 python3 $DATA/scripts/fetch_options.py --db $STOCKDB/stockdb.db >> /tmp/fetch_options.log

# Daily EOD from Yahoo Finance — weekdays at 5pm
0 17 * * 1-5 python3 $STOCKDB/fetch_eod_daily.py --db $STOCKDB/stockdb.db >> $STOCKDB/logs/eod_daily.log

# Capture live option prices as EOD data — weekdays at 4pm AEST (6am UTC)
0 6 * * 2-6 python3 $DATA/scripts/fetch_options_eod.py --db $STOCKDB/stockdb.db >> /tmp/fetch_options_eod.log

# Refresh cached option quotes at 4:30pm AEST (6:30am UTC) — weekdays
# Pre-warms cache so users see fast page load the next morning
30 6 * * 1-5 cd $WEB && python3 scripts/refresh_option_quotes.py >> /tmp/refresh_option_quotes.log 2>&1

# And then run the algos
30 17 * * 1-5 cd $WEB && python3 algo_runner.py >> /tmp/algo_runner.log

# Weekly fundamentals from Yahoo Finance — Friday evening (after EOD + algos)
30 18 * * 5 python3 $DATA/scripts/fetch_fundamentals.py --db $STOCKDB/stockdb.db >> /tmp/fetch_fundamentals.log

# Weekly events fetch — Friday after fundamentals
0 19 * * 5 python3 $DATA/scripts/fetch_events.py --db $STOCKDB/stockdb.db >> /tmp/fetch_events.log 2>&1

# Monthly annual financial statements (income/balance/cashflow) — Saturday after weekly fundamentals
0 21 * * 6 python3 $DATA/scripts/fetch_financials.py --db $STOCKDB/stockdb.db >> /tmp/fetch_financials.log

# Monthly shares-on-issue history — Saturday after financials
30 21 * * 6 python3 $DATA/scripts/fetch_shares.py --db $STOCKDB/stockdb.db >> /tmp/fetch_shares.log

# Monthly dividends from Yahoo Finance — 1st of each month at 19:00 UTC
0 19 1 * * python3 $DATA/scripts/fetch_dividends.py --db $STOCKDB/stockdb.db >> /tmp/fetch_dividends.log

# Daily commodity prices (yfinance) — weekdays 21:00 UTC (7am AEST next day)
# Switch to --source te and add TE_API_KEY=... when a Trading Economics key is available
0 21 * * 1-5 python3 $DATA/scripts/fetch_commodities.py --db $STOCKDB/stockdb.db --source yf >> /tmp/fetch_commodities.log

# Trading Economics commodities — weekly Wednesday 22:00 UTC (Thursday 8am AEST)
# Fetches: THERMAL-COAL, ALUMINIUM, ZINC, NICKEL, LEAD, IRON-ORE, NATURAL-GAS
0 22 * * 3 python3 $DATA/scripts/fetch_trading_economics.py --db $STOCKDB/stockdb.db --all >> /tmp/fetch_trading_economics.log 2>&1

# Manganese price from Jupiter Mines/Shanghai Metals Market — weekly Saturday 22:00 UTC (Sunday 8am AEST)
# Fetches: MANGANESE in CNY/mtu
0 22 * * 6 python3 $DATA/scripts/fetch_manganese.py --db $STOCKDB/stockdb.db >> /tmp/fetch_manganese.log 2>&1

# Industrial metals from metals.dev API — weekly Sunday 22:00 UTC (Monday 8am AEST)
# Fetches: LEAD, ALUMINIUM, ZINC, NICKEL (all in one API request)
0 22 * * 0 python3 $DATA/scripts/fetch_metals_dev.py --db $STOCKDB/stockdb.db --api-key $METALS_DEV_API_KEY >> /tmp/fetch_metals_dev.log 2>&1

# Previous business day catch-up — fills any announcements filed after the last --today run
30 6 * * 1-5 python3 $ANNOUNCEMENTS/asx_scraper.py >> $ANNOUNCEMENTS/logs/prevday.log 2>&1

# Today's ASX announcements — fetched throughout the trading day (AEST)
1 8 * * 1-5 python3 $ANNOUNCEMENTS/asx_scraper.py --today >> $ANNOUNCEMENTS/logs/today.log
2 9 * * 1-5 python3 $ANNOUNCEMENTS/asx_scraper.py --today >> $ANNOUNCEMENTS/logs/today.log 2>&1
33 9 * * 1-5 python3 $ANNOUNCEMENTS/asx_scraper.py --today >> $ANNOUNCEMENTS/logs/today.log 2>&1
44 9 * * 1-5 python3 $ANNOUNCEMENTS/asx_scraper.py --today >> $ANNOUNCEMENTS/logs/today.log 2>&1
59 9 * * 1-5 python3 $ANNOUNCEMENTS/asx_scraper.py --today >> $ANNOUNCEMENTS/logs/today.log 2>&1
15 10 * * 1-5 python3 $ANNOUNCEMENTS/asx_scraper.py --today >> $ANNOUNCEMENTS/logs/today.log 2>&1
45 11 * * 1-5 python3 $ANNOUNCEMENTS/asx_scraper.py --today >> $ANNOUNCEMENTS/logs/today.log 2>&1
45 13 * * 1-5 python3 $ANNOUNCEMENTS/asx_scraper.py --today >> $ANNOUNCEMENTS/logs/today.log 2>&1
45 15 * * 1-5 python3 $ANNOUNCEMENTS/asx_scraper.py --today >> $ANNOUNCEMENTS/logs/today.log 2>&1
15 17 * * 1-5 python3 $ANNOUNCEMENTS/asx_scraper.py --today >> $ANNOUNCEMENTS/logs/today.log 2>&1

# Extract structured data from new announcement PDFs
# — mid-morning run catches pre-market announcements (after 10:15 scraper completes)
# — end-of-day run catches all remaining announcements
30 10 * * 1-5 $ANNOUNCEMENTS/venv/bin/python3 $ANNOUNCEMENTS/extract_structured.py >> $ANNOUNCEMENTS/logs/extract.log 2>&1
30 17 * * 1-5 $ANNOUNCEMENTS/venv/bin/python3 $ANNOUNCEMENTS/extract_structured.py >> $ANNOUNCEMENTS/logs/extract.log 2>&1

# Weekly cleanup of fermi_api_calls rows older than 90 days (Sunday 3am)
0 3 * * 0 python3 -c "import sqlite3,os; from datetime import datetime,timezone,timedelta; db=os.path.join('$WEB','users.db'); c=sqlite3.connect(db); r=c.execute('DELETE FROM fermi_api_calls WHERE timestamp < ?',((datetime.now(timezone.utc)-timedelta(days=90)).strftime('%Y-%m-%dT%H:%M:%SZ'),)); c.commit(); print(f'Deleted {r.rowcount} rows'); c.close()" >> /tmp/fermi_cleanup.log 2>&1
